# 生产环境
VITE_APP_TITLE=mshop admin
VITE_PORT=8013
VITE_OPEN=false
VITE_BASE_URL=
# 生产环境：留空即同源相对路径，由 Nginx 将 /admin 反代到后端，无需写死域名
# 若前端与后端不同源，才需要填完整地址，例如 VITE_BASE_API=http://xxx.test.com/admin
VITE_BASE_API=/admin
# 前端部署在子目录时才需要配置，部署在站点根目录保持 /
VITE_BASE_PATH=/
VITE_OUT_DIR=dist
VITE_SOURCEMAP=false
VITE_DROP_DEBUGGER=true
VITE_DROP_CONSOLE=true
